# ---------------------------------------------------------------------------
# Who Printed — Dune Data API key — https://dune.com/settings/api
# The Data API needs a paid Dune plan; each query execution burns credits, so
# results are cached (see CACHE_TTL_SECONDS below).
# ---------------------------------------------------------------------------
DUNE_API_KEY=

# ---------------------------------------------------------------------------
# Query IDs. Run `npm run setup:dune` to create all four queries in your Dune
# account and it will print these lines ready to paste. Or create them by hand
# from the .sql files in dune/ and copy the ID out of the query URL.
# ---------------------------------------------------------------------------
DUNE_QUERY_TRADERS_SOLANA=
DUNE_QUERY_TRADERS_EVM=
DUNE_QUERY_HOLDERS_SOLANA=
DUNE_QUERY_HOLDERS_EVM=

# ---------------------------------------------------------------------------
# Tuning
# ---------------------------------------------------------------------------
# How long a result is reused before a fresh execution is paid for.
CACHE_TTL_SECONDS=1800

# Before paying for an execution, Who Printed asks Dune whether it still holds the
# rows from the last run of the same query with the same parameters. That
# lookup starts nothing and costs no execution, and the queries are public, so
# a token anyone has already traced comes back in one round trip instead of the
# minutes a cold Solana scan takes. This is how old such a result may be and
# still be served; the age is shown next to the results and Refresh always
# forces a live run. Raising it trades freshness for spend directly. Set to 0
# to always execute.
DUNE_RESULT_MAX_AGE_MINUTES=720
# ---------------------------------------------------------------------------
# SPEND
# ---------------------------------------------------------------------------
# Dune bills an execution for the compute it uses and the time it occupies the
# engine -- reading the rows afterwards is charged separately in datapoints
# (rows x columns) and is small change next to it. A 100-wallet result is 3,500
# datapoints; the multi-minute scan that produced it is the bill.
#
# So the things that actually reduce spend, in order:
#   1. Not executing at all. DUNE_RESULT_MAX_AGE_MINUTES below reuses a run
#      Dune already has, and the app rejoins its own in-flight executions
#      rather than starting a second one after a reload.
#   2. A smaller engine tier.
#   3. A faster query, since the bill tracks engine time.
#
# Engine tier: small | medium | large. Unset, the traders scan runs on large
# and the holders lookup on medium. `small` is gated by subscription and is
# rejected outright on the plans this targets, so it is never chosen by default;
# a tier the account cannot use falls back to Dune's own.
#
# Do not "save money" by lowering the traders tier without measuring it. A
# smaller engine costs less per second but occupies the engine for longer, and
# the bill is time x rate. Measured on one token at 1095d: large finished in
# 116s, medium was still running after 25 minutes -- more than twelve times the
# engine time, and past the point where the client gives up waiting.
# DUNE_PERFORMANCE=medium
# Default trade window in days. 365 by default: a window that starts after a
# token launched silently drops the launch-period buys, which is where the
# winners are. Scanning a year costs about the same as 90 days.
DEFAULT_LOOKBACK_DAYS=365
# Ignore wallets that traded less than this in total USD.
DEFAULT_MIN_USD=50
# How long to poll a Dune execution before giving up. A cold Solana balance
# scan can run five minutes or more, so keep this generous.
DUNE_TIMEOUT_MS=600000
# Max wallets a single request may ask for.
MAX_WALLET_LIMIT=500
